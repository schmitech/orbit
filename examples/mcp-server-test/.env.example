# The harness reads this file, then the repo-root .env, then the real environment.
# Anything already exported in your shell wins.

# --- MCP server under test (examples/mcp-server) ---
MCP_URL=http://127.0.0.1:9999/mcp
MCP_TOKEN=test-secret

# --- Providers. A provider with no key is SKIPPED, not failed. ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Azure AI Foundry needs BOTH a key and an endpoint: a deployment is bound to
# its own endpoint, so the key alone cannot reach it. Copy the endpoint from
# the deployment's Foundry page — the versionless /openai/v1 form, matching
# config/azure.yaml. Missing either one skips Azure, it never fails the run.
AZURE_ACCESS_KEY=
AZURE_INFERENCE_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1

# Override the models under test (defaults track config/inference.yaml).
# EVAL_OPENAI_MODEL=gpt-5.4-mini
# EVAL_ANTHROPIC_MODEL=claude-sonnet-4-6
# Azure routes on the DEPLOYMENT name, not a model id.
# EVAL_AZURE_DEPLOYMENT=gpt-5-mini

# --- LangSmith is entirely optional. Unset = fully offline. ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orbit-mcp-server-test

# Let pytest start/stop the Node MCP server itself. Off by default; it will
# never touch a server it did not start.
ORBIT_MCP_TEST_AUTOSTART=0
